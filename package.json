{
  "name": "dj-toolbelt",
  "version": "0.1.0",
  "private": true,
  "description": "A map of how DJs discover, prepare, perform and share music — not just a directory of DJ websites. Every resource is filed under the job it does and the order you use it in.",
  "homepage": "https://dj-toolbelt.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Omar12/dj-toolbelt.git"
  },
  "bugs": {
    "url": "https://github.com/Omar12/dj-toolbelt/issues"
  },
  "license": "MIT",
  "keywords": [
    "dj",
    "music",
    "music-discovery",
    "camelot",
    "bpm",
    "harmonic-mixing",
    "nextjs",
    "vibe-coding"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check": "node --experimental-strip-types scripts/check.ts",
    "linkcheck": "bash scripts/linkcheck.sh"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
